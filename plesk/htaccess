# Alleen nodig bij de Passenger-route (methode B in PLESK.md).
# Kopieer naar de projectroot als .htaccess:
#   cp plesk/htaccess .htaccess

PassengerEnabled On
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py
PassengerPython /var/www/vhosts/app.example.nl/kasflow/venv/bin/python
PassengerFriendlyErrorPages Off

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
<FilesMatch "\.(py|pyc|sqlite3)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
