# Kopieer dit bestand naar de projectroot als .env
#   cp plesk/env.example .env
# Zet .env nooit in git. Rechten: chmod 600 .env

KASFLOW_ENV=production
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
KASFLOW_SECRET_KEY=

KASFLOW_PUBLIC_URL=https://app.example.nl
KASFLOW_ALLOWED_HOSTS=app.example.nl,www.app.example.nl

# Database die je in Plesk > Databases hebt aangemaakt (PostgreSQL).
# Wachtwoorden met @ : / # moeten URL-encoded.
KASFLOW_DATABASE_URL=postgresql+psycopg://kasflow:WACHTWOORD@localhost:5432/kasflow

KASFLOW_UPLOAD_DIR=/var/www/vhosts/app.example.nl/kasflow/backend/uploads
KASFLOW_MAX_UPLOAD_MB=10
KASFLOW_SESSION_MAX_AGE=43200

KASFLOW_SMTP_HOST=mail.example.nl
KASFLOW_SMTP_PORT=587
KASFLOW_SMTP_SECURITY=starttls
KASFLOW_SMTP_USER=noreply@example.nl
KASFLOW_SMTP_PASSWORD=
KASFLOW_MAIL_FROM=noreply@example.nl
KASFLOW_MAIL_FROM_NAME=Kasflow
