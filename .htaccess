# /api draait als CGI (kasflow.cgi), zodat Git-deploy werkt zonder poort 8010
# en zonder systemd. LiteSpeed voert .cgi uit als de abonnement-gebruiker.

AddHandler cgi-script .cgi

RewriteEngine On
RewriteRule ^\.well-known/ - [L]
RewriteRule ^api(/.*)?$ kasflow.cgi [L,QSA]

<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
<FilesMatch "\.(py|pyc|sqlite3)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
RedirectMatch 404 /\.git
