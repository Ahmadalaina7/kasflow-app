# LiteSpeed/Apache: /api via PHP. CGI-scripts zijn op deze hosting 403.
# PHP start Python per verzoek (geen poort 8010, geen systemd).

RewriteEngine On
RewriteRule ^\.well-known/ - [L]
RewriteRule ^api(/.*)?$ proxy.php [L,QSA]

<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
<FilesMatch "\.(py|pyc|sqlite3)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
RedirectMatch 404 /\.git
