# LiteSpeed (Plesk): /api gaat naar proxy.php, dat Python start.
# Zie PLESK.md. Alles daarbuiten wordt als bestand geserveerd.

RewriteEngine On
RewriteRule ^\.well-known/ - [L]

# Servercode en gegevens nooit via de webserver bereikbaar.
RewriteRule ^(backend|plesk)(/|$) - [F]
RewriteRule ^\.git(/|$) - [F]
RewriteRule ^(\.env(\..*)?|.*\.sqlite3)$ - [F]

RewriteRule ^api(/.*)?$ proxy.php [L,QSA]

<FilesMatch "\.(py|pyc|sh|log|sqlite3)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
