# Kasflow-configuratie. Kopieer dit bestand naar .env en vul echte waarden in.
# Zet .env nooit in git of in een back-up die publiek deelbaar is.

# ---------- Verplicht ----------
# Productie weigert te starten zonder deze waarden.
KASFLOW_ENV=production
# Genereer met: python -c "import secrets; print(secrets.token_urlsafe(48))"
KASFLOW_SECRET_KEY=
# Publieke URL zonder afsluitende slash. Moet https zijn in productie.
KASFLOW_PUBLIC_URL=https://app.example.nl
# Alleen deze hostnamen mogen de app aanroepen (komma-gescheiden).
KASFLOW_ALLOWED_HOSTS=app.example.nl

# ---------- Database (Compose zet de URL zelf) ----------
POSTGRES_DB=kasflow
POSTGRES_USER=kasflow
# Genereer met: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------- Domein en HTTPS ----------
KASFLOW_DOMAIN=app.example.nl
ACME_EMAIL=jij@example.nl

# ---------- Uploads en sessies ----------
KASFLOW_UPLOAD_DIR=/app/backend/uploads
KASFLOW_MAX_UPLOAD_MB=10
KASFLOW_SESSION_MAX_AGE=43200

# ---------- E-mail via je Cloud86-mailbox ----------
# Zonder deze instelling werkt Kasflow in logmodus: mails worden gelogd en niet
# verstuurd, en e-mailverificatie wordt overgeslagen.
KASFLOW_SMTP_HOST=mail.example.nl
KASFLOW_SMTP_PORT=587
# starttls (587) | ssl (465) | none (alleen voor lokale relays)
KASFLOW_SMTP_SECURITY=starttls
KASFLOW_SMTP_USER=noreply@example.nl
KASFLOW_SMTP_PASSWORD=
KASFLOW_MAIL_FROM=noreply@example.nl
KASFLOW_MAIL_FROM_NAME=Kasflow

# ---------- KVK Handelsregister ----------
# Optioneel. Met sleutel controleert Kasflow nummer én naam hard bij de officiële
# KVK Zoeken-API. Aanvragen (later, als Kasflow B.V.): https://developers.kvk.nl/
# Zonder sleutel gebruiken we de gratis KVK-check van Bedrijfsdata.nl
# (https://free.bedrijfsdata.nl — géén api_key). In hun docs staat geen echte
# sleutel, alleen de placeholder my_api_key; een betaalde key krijg je via
# https://developers.bedrijfsdata.nl/register
KASFLOW_KVK_API_KEY=
KASFLOW_KVK_BASE_URL=

# ---------- Abonnementen via Mollie (iDEAL) ----------
# Zonder sleutel start de app gewoon, maar kan niemand betalen: de proefperiode
# van 14 dagen loopt door en Instellingen legt uit wat er ontbreekt.
# Test: test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx — Live: live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KASFLOW_MOLLIE_API_KEY=

# ---------- Bestanden op een Archil-disk ----------
# Optioneel en alleen server-side: zonder sleutel start de app gewoon door en
# werken alleen de functies in backend/archil_storage.py niet.
# API-sleutel uit https://console.archil.com/api-keys. Begint met key-; een
# disk- of mounttoken (adt_…) hoort hier niet en krijgt een 401.
ARCHIL_API_KEY=
# Regio waarin de sleutel is aangemaakt; de sleutel werkt alleen daar.
ARCHIL_REGION=aws-us-east-1
# Id van de disk (dsk-…): laat leeg tot je er een hebt aangemaakt.
ARCHIL_DISK_ID=
